{
  "openapi": "3.0.1",
  "info": {
    "title": "项目管理系统开放 API",
    "description": "提供给第三方的项目管理及操作接口。本文档包含了项目的创建、查询、更新等操作规范。",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1"
    }
  ],
  "paths": {
    "/thirdparty/createProject": {
      "post": {
        "tags": ["项目管理 (表单输入示例)"],
        "summary": "创建项目",
        "description": "支持创建空项目。isEmpty 参数为 true 时，项目中不包含任何文档，为 false 时，项目中会创建一个零件文档与一个装配文档。此属性非必需，默认值为 false。isPublic 参数为 true 时，创建的项目为私有项目。此属性非必需，默认值为 false。",
        "operationId": "createProject",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer xxx<token>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["projectName"],
                "properties": {
                  "projectName": {
                    "type": "string",
                    "description": "项目名称"
                  },
                  "isEmpty": {
                    "type": "boolean",
                    "default": false,
                    "description": "项目是否为空"
                  },
                  "isPublic": {
                    "type": "boolean",
                    "default": false,
                    "description": "项目是否为公开项目"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "返回码。200: 成功; 403: 非法请求。"
                    },
                    "message": {
                      "type": "string",
                      "description": "结果描述"
                    },
                    "data": {
                      "type": "object",
                      "description": "返回信息",
                      "properties": {
                        "projectId": {
                          "type": "string",
                          "description": "新创建的项目 ID"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "创建时间"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/thirdparty/uploadDocument": {
      "post": {
        "tags": ["文档管理 (文件上传示例)"],
        "summary": "上传项目文档",
        "description": "上传二进制文件到指定的项目中。",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": true,
            "description": "目标项目 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "documentName"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "需要上传的二进制文件 (支持 doc, pdf, zip)"
                  },
                  "documentName": {
                    "type": "string",
                    "description": "文档重命名名称"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "文档分类标签"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/thirdparty/addMember": {
      "post": {
        "tags": ["成员管理 (JSON 输入示例)"],
        "summary": "添加项目成员",
        "description": "通过标准的 application/json 格式添加新成员到项目组。",
        "operationId": "addMember",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["projectId", "userInfo"],
                "properties": {
                  "projectId": {
                    "type": "string",
                    "description": "项目 ID"
                  },
                  "notifyUser": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否发送邮件通知"
                  },
                  "userInfo": {
                    "$ref": "#/components/schemas/MemberInfo"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "添加成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/thirdparty/updateConfig": {
      "put": {
        "tags": ["配置管理 (URL-Encoded 示例)"],
        "summary": "更新项目全局配置",
        "description": "使用 application/x-www-form-urlencoded 格式提交简单的键值对更新。",
        "operationId": "updateConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "themeColor": {
                    "type": "string",
                    "description": "项目主题色 (Hex)"
                  },
                  "enableWatermark": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否开启水印"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/thirdparty/getProjectDetail": {
      "get": {
        "tags": ["项目管理 (Query 参数示例)"],
        "summary": "获取项目详情",
        "description": "根据项目 ID 查询指定项目的详细信息，包括成员列表和当前状态。",
        "operationId": "getProjectDetail",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer xxx<token>",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "required": true,
            "description": "需要查询的项目唯一 ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeMembers",
            "in": "query",
            "required": false,
            "description": "是否同时返回项目成员列表",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetailResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "返回状态码"
          },
          "message": {
            "type": "string",
            "description": "错误信息或操作结果提示"
          }
        }
      },
      "ProjectDetailResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "返回码"
          },
          "message": {
            "type": "string",
            "description": "结果描述"
          },
          "data": {
            "type": "object",
            "description": "项目详情实体",
            "properties": {
              "id": {
                "type": "string",
                "description": "项目 ID"
              },
              "name": {
                "type": "string",
                "description": "项目名称"
              },
              "status": {
                "type": "string",
                "description": "项目当前状态",
                "enum": ["ACTIVE", "ARCHIVED", "DELETED"]
              },
              "members": {
                "type": "array",
                "description": "项目成员列表（仅当 includeMembers=true 时返回）",
                "items": {
                  "$ref": "#/components/schemas/MemberInfo"
                }
              }
            }
          }
        }
      },
      "MemberInfo": {
        "type": "object",
        "required": ["userId", "role"],
        "properties": {
          "userId": {
            "type": "string",
            "description": "用户唯一标识"
          },
          "userName": {
            "type": "string",
            "description": "用户昵称"
          },
          "role": {
            "type": "string",
            "description": "用户在该项目中的角色",
            "enum": ["ADMIN", "EDITOR", "VIEWER"]
          }
        }
      }
    }
  }
}
